[Unit]
Description=Periodic pg_flashback backup-anchor reconciliation
Documentation=file:///usr/share/doc/pg_flashback/EXPERIMENTAL_BACKUP.md

[Timer]
# Conservative default: verify/advance only; does not initiate backups.
OnCalendar=hourly
RandomizedDelaySec=10m
Persistent=true
Unit=pg-flashback-reconcile-anchors.service

[Install]
WantedBy=timers.target
