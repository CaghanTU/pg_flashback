  "generated_at": "2026-07-28T04:25:00Z",
  "harness": "scripts/poc/run_poc_storage_backend_benchmark.sh",
  "harness_commit_range": "526391b..a117ce2",
  "final_harness_commit": "a117ce2440514c9f6ac73ee73acd5fd49e0510b9",
  "scope_note": "PoC-level unbiased comparison of three storage backends for a DROP-recovery snapshot artifact, sharing the exact same Protocol B boundary/marker choreography and WAL-replay correctness oracle Step 7 already qualified. Not production-wired: no production SnapshotStore backend, no storage_backend CHECK constraint change, no public API/GUC change.",
  "harness_corrections_during_this_round": [
    {
      "commit": "3ea2b38",
      "change": "compression_ratio metric always recorded 0 (bc not installed in this environment); switched to awk."
    },
    {
      "commit": "ab85091",
      "change": "Two real bugs from the first crash-mode smoke runs: establish_boundary_and_materialize's oracle-shadow bookkeeping had no ON CONFLICT/DROP-IF-EXISTS guard (crash-mode retries call it twice against the same source table); and restore_in_db_logged_zstd/restore_external_zstd die() internally via a direct exit call, which a bare '|| flag=1' at the call site cannot catch -- fixed with subshell+if wrapping."
    },
    {
      "commit": "45b2744",
      "change": "load_ground_truth_from_rawfile had the same not-safely-re-callable bug as the oracle shadow fix above."
    },
    {
      "commit": "ecb851e",
      "change": "persist_in_db_logged_zstd/persist_external_zstd had no error checking on their manifest-row INSERT, so duplicate_retry's expected PK-collision failure was silently swallowed under errexit suspension rather than propagated; added explicit die() guards."
    },
    {
      "commit": "833ed33",
      "change": "commits_replayed==copy_window_commits was too strict: a real 1 GiB run hit commits_replayed=64 vs copy_window_commits=61, root-caused to the writer loop's counter file being written AFTER a statement already committed durably to WAL, racing against SIGTERM during shutdown. Data was never lost; only the writer's own self-reported count could lag. Relaxed to >=."
    },
    {
      "commit": "b03243f",
      "change": "cleanup() never purged the bulky rawstream_*.bin/chunks_*//restore_*/ working files (not evidence), which accumulated to 37G across one session's runs and caused three otherwise-correct 1 GiB reruns to fail on real ENOSPC. Extended cleanup() to remove them under the same POC_KEEP gate as DATA/PGLIB."
    },
    {
      "commit": "a117ce2",
      "change": "heap_v1's artifact_bytes was always recorded 0 (no separate persist phase populates it), biasing the storage comparison. Added a direct pg_total_relation_size measurement for heap_v1's own artifact table."
    }
  ],
