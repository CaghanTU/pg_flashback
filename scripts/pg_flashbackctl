#!/usr/bin/env bash
# pg_flashbackctl — thin operator wrapper around supported SQL APIs.
#
# Uses libpq/psql configuration (PGHOST/PGPORT/PGDATABASE/PGUSER/.pgpass).
# Does not store credentials, edit postgresql.conf, restart PostgreSQL,
# create backups, choose a profile automatically, or restore without --yes.
set -Eeuo pipefail

PSQL_BIN="${PSQL_BIN:-psql}"
STATEMENT_TIMEOUT_MS="${PG_FLASHBACKCTL_STATEMENT_TIMEOUT_MS:-120000}"
TRACK_HEALTH_TIMEOUT_S="${PG_FLASHBACKCTL_TRACK_HEALTH_TIMEOUT_S:-60}"
RESTORE_HEALTH_TIMEOUT_S="${PG_FLASHBACKCTL_RESTORE_HEALTH_TIMEOUT_S:-120}"
JSON_OUT=0

usage() {
    cat <<'EOF'
Usage: pg_flashbackctl [--json] <command> [args]

Commands:
  doctor
  advise TABLE
  track TABLE
  status [TABLE]
  disasters TABLE [LOOKBACK]
  resolve TABLE TIMESTAMP
  restore TABLE LSN --yes

Environment:
  Standard libpq variables (PGHOST, PGPORT, PGDATABASE, PGUSER, ...).
  PG_FLASHBACKCTL_STATEMENT_TIMEOUT_MS   default 120000
  PG_FLASHBACKCTL_TRACK_HEALTH_TIMEOUT_S default 60
  PG_FLASHBACKCTL_RESTORE_HEALTH_TIMEOUT_S default 120
EOF
}

die() { echo "pg_flashbackctl: $*" >&2; exit 2; }

reject_controls() {
    local name=$1 value=$2
    if [[ "$value" == *[[:cntrl:]]* ]]; then
        die "refusing control characters in $name"
    fi
}

# Run SQL from stdin with optional psql -v assignments. Always uses
# psql -X -v ON_ERROR_STOP=1 and a bounded statement_timeout.
psql_stdin() {
    local timeout_sql="SET statement_timeout TO ${STATEMENT_TIMEOUT_MS};"
    {
        printf '%s\n' "$timeout_sql"
        cat
    } | "$PSQL_BIN" -X -v ON_ERROR_STOP=1 "$@"
}

psql_tuples() {
    psql_stdin -qAt "$@"
}

cmd_doctor() {
    local errors
    if [[ "$JSON_OUT" == 1 ]]; then
        psql_tuples <<'SQL'
SELECT COALESCE(json_agg(row_to_json(d) ORDER BY d.check_name), '[]'::json)
FROM flashback_doctor() d;
SQL
    else
        psql_stdin <<'SQL'
SELECT scope, check_name, status, observed, expected, action
FROM flashback_doctor()
ORDER BY CASE status WHEN 'error' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END,
         check_name;
SQL
    fi
    errors=$(psql_tuples <<'SQL'
SELECT count(*) FROM flashback_doctor() WHERE status='error';
SQL
)
    [[ "$errors" == "0" ]] || exit 1
}

cmd_advise() {
    local table=$1
    reject_controls table "$table"
    if [[ "$JSON_OUT" == 1 ]]; then
        psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(json_agg(row_to_json(a)), '[]'::json)
FROM flashback_advise((:'table')::regclass) a;
SQL
    else
        psql_stdin -v "table=$table" <<'SQL'
SELECT * FROM flashback_advise((:'table')::regclass);
SQL
    fi
}

cmd_track() {
    local table=$1
    local deadline health
    reject_controls table "$table"
    psql_tuples -v "table=$table" <<'SQL' >/dev/null
SELECT flashback_track(:'table');
SQL
    deadline=$(( $(date +%s) + TRACK_HEALTH_TIMEOUT_S ))
    while (( $(date +%s) <= deadline )); do
        health=$(psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(
    (SELECT health FROM flashback_health()
     WHERE table_name = (
         SELECT format('%I.%I', n.nspname, c.relname)
         FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE c.oid = (:'table')::regclass
     )
     LIMIT 1),
    'missing'
);
SQL
)
        if [[ "$health" == "healthy" ]]; then
            echo "tracked: $table health=healthy"
            return 0
        fi
        sleep 0.1
    done
    die "timed out waiting for healthy boundary on $table (last health=${health:-missing})"
}

cmd_status() {
    local table=${1:-}
    if [[ -n "$table" ]]; then
        reject_controls table "$table"
        if [[ "$JSON_OUT" == 1 ]]; then
            psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(json_agg(row_to_json(h)), '[]'::json)
FROM flashback_health() h
WHERE h.table_name = (
        SELECT format('%I.%I', n.nspname, c.relname)
        FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
        WHERE c.oid = (:'table')::regclass
      )
   OR h.table_name = :'table';
SQL
        else
            psql_stdin -v "table=$table" <<'SQL'
SELECT * FROM flashback_health() h
WHERE h.table_name = (
        SELECT format('%I.%I', n.nspname, c.relname)
        FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
        WHERE c.oid = (:'table')::regclass
      )
   OR h.table_name = :'table';
SQL
        fi
    else
        if [[ "$JSON_OUT" == 1 ]]; then
            psql_tuples <<'SQL'
SELECT COALESCE(json_agg(row_to_json(h)), '[]'::json) FROM flashback_health() h;
SQL
        else
            psql_stdin <<'SQL'
SELECT tracking_id, table_name, recovery_profile, health,
       recommended_action, valid_through_lsn, open_gap_count, reason
FROM flashback_health()
ORDER BY tracking_id;
SQL
        fi
    fi
}

cmd_disasters() {
    local table=$1
    local lookback=${2:-24 hours}
    reject_controls table "$table"
    reject_controls lookback "$lookback"
    if [[ "$JSON_OUT" == 1 ]]; then
        psql_tuples -v "table=$table" -v "lookback=$lookback" <<'SQL'
SELECT COALESCE(json_agg(row_to_json(d)), '[]'::json)
FROM flashback_disaster_points(:'table', :'lookback'::interval) d;
SQL
    else
        psql_stdin -v "table=$table" -v "lookback=$lookback" <<'SQL'
SELECT * FROM flashback_disaster_points(:'table', :'lookback'::interval);
SQL
    fi
}

cmd_resolve() {
    local table=$1
    local ts=$2
    reject_controls table "$table"
    reject_controls ts "$ts"
    if [[ "$JSON_OUT" == 1 ]]; then
        psql_tuples -v "table=$table" -v "ts=$ts" <<'SQL'
SELECT COALESCE(json_agg(row_to_json(r)), '[]'::json)
FROM flashback_resolve_target(:'table', :'ts'::timestamptz) r;
SQL
    else
        psql_stdin -v "table=$table" -v "ts=$ts" <<'SQL'
SELECT * FROM flashback_resolve_target(:'table', :'ts'::timestamptz);
SQL
    fi
}

cmd_restore() {
    local table=$1
    local lsn=$2
    local confirm=${3:-}
    [[ "$confirm" == "--yes" ]] || die "restore requires explicit --yes after TABLE LSN"
    reject_controls table "$table"
    reject_controls lsn "$lsn"
    echo "restoring $table to LSN $lsn"
    psql_tuples -v "table=$table" -v "lsn=$lsn" <<'SQL' >/dev/null
SELECT CASE
    WHEN to_regclass(:'table') IS NULL THEN 0
    ELSE flashback_local_restore_preflight(to_regclass(:'table'))
END;
SELECT flashback_restore_lsn(:'table', :'lsn'::pg_lsn);
SQL
    local deadline health
    deadline=$(( $(date +%s) + RESTORE_HEALTH_TIMEOUT_S ))
    while (( $(date +%s) <= deadline )); do
        health=$(psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(
    (SELECT health FROM flashback_health()
     WHERE table_name = (
         SELECT format('%I.%I', n.nspname, c.relname)
         FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE c.oid = (:'table')::regclass
     )
     LIMIT 1),
    'missing'
);
SQL
)
        if [[ "$health" == "healthy" ]]; then
            echo "restore complete: $table health=healthy"
            return 0
        fi
        sleep 0.1
    done
    die "restore finished but successor health wait timed out (last health=${health:-missing})"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --json) JSON_OUT=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
    esac
done

[[ $# -ge 1 ]] || { usage; exit 2; }
cmd=$1
shift

case "$cmd" in
    doctor)
        [[ $# -eq 0 ]] || die "doctor takes no arguments"
        cmd_doctor
        ;;
    advise)
        [[ $# -eq 1 ]] || die "advise requires TABLE"
        cmd_advise "$1"
        ;;
    track)
        [[ $# -eq 1 ]] || die "track requires TABLE"
        cmd_track "$1"
        ;;
    status)
        [[ $# -le 1 ]] || die "status accepts optional TABLE"
        cmd_status "${1:-}"
        ;;
    disasters)
        [[ $# -ge 1 && $# -le 2 ]] || die "disasters requires TABLE [LOOKBACK]"
        cmd_disasters "$1" "${2:-24 hours}"
        ;;
    resolve)
        [[ $# -eq 2 ]] || die "resolve requires TABLE TIMESTAMP"
        cmd_resolve "$1" "$2"
        ;;
    restore)
        [[ $# -eq 3 ]] || die "restore requires TABLE LSN --yes"
        cmd_restore "$1" "$2" "$3"
        ;;
    *)
        die "unknown command: $cmd"
        ;;
esac
