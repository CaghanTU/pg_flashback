#!/usr/bin/env bash
# pg_flashback — end-user operator CLI for local DROP recovery.
#
# Primary product flow:
#   pg_flashback doctor
#   pg_flashback protect TABLE
#   pg_flashback status [TABLE]
#   pg_flashback recover TABLE
#
# Uses libpq/psql configuration (PGHOST/PGPORT/PGDATABASE/PGUSER/.pgpass).
# Does not store credentials, edit postgresql.conf, restart PostgreSQL,
# create backups, or restore without explicit confirmation/--yes.
set -Eeuo pipefail

PSQL_BIN="${PSQL_BIN:-psql}"
STATEMENT_TIMEOUT_MS="${PG_FLASHBACK_STATEMENT_TIMEOUT_MS:-${PG_FLASHBACKCTL_STATEMENT_TIMEOUT_MS:-120000}}"
PROTECT_HEALTH_TIMEOUT_S="${PG_FLASHBACK_PROTECT_HEALTH_TIMEOUT_S:-${PG_FLASHBACKCTL_TRACK_HEALTH_TIMEOUT_S:-60}}"
RECOVER_HEALTH_TIMEOUT_S="${PG_FLASHBACK_RECOVER_HEALTH_TIMEOUT_S:-${PG_FLASHBACKCTL_RESTORE_HEALTH_TIMEOUT_S:-120}}"
DISCOVERY_TIMEOUT_S="${PG_FLASHBACK_DISCOVERY_TIMEOUT_S:-30}"
MAINTAIN_FINALIZE_TIMEOUT_S="${PG_FLASHBACK_MAINTAIN_FINALIZE_TIMEOUT_S:-120}"
JSON_OUT=0
VERBOSE=0
YES=0
LATEST_DROP=0
DRY_RUN=0
ALL_DATABASES=0
AT_TIMESTAMP=""
AT_LSN=""
DISASTER_EVENT_ID=""
LOOKBACK=""
CLI_VERSION="0.2.0"

usage() {
    cat <<'EOF'
Usage: pg_flashback [options] <command> [args]

Commands:
  version
  doctor [--reconcile] [--all-databases]
  config recommend [TABLE]
  protect TABLE
  list
  status [TABLE] [--all-databases]
  history [TABLE]
  changes [TABLE]          # optional row-change history (sensitive)
  recover TABLE [--latest-drop] [--yes] [--dry-run] [--lookback INTERVAL]
                [--event-id ID] [--at TIMESTAMP] [--lsn LSN]
  unprotect TABLE [--yes]
  cleanup --tracking-id ID [--dry-run] [--yes]
  maintain TABLE|--all [--dry-run|--yes] [--if-needed]
  prepare-uninstall [--yes]

Options:
  --json       Machine-readable JSON envelope on stdout (before or after command)
  --verbose    Include technical details in human output (before or after command)
  --lookback   Recover lookback window (default: retained horizon for the table)
  -h, --help   Show this help

Exit codes:
  0  success
  1  operational failure / partial multi-DB failure
  2  usage / configuration error

Environment (libpq):
  PGHOST, PGPORT, PGDATABASE, PGUSER, .pgpass
  Never pass passwords on the CLI argv.

Environment (pg_flashback):
  PG_FLASHBACK_STATEMENT_TIMEOUT_MS      default 120000
  PG_FLASHBACK_PROTECT_HEALTH_TIMEOUT_S  default 60
  PG_FLASHBACK_RECOVER_HEALTH_TIMEOUT_S  default 120
  PG_FLASHBACK_DISCOVERY_TIMEOUT_S       default 30 (post-DROP / manifest bind poll)

Typical recovery after an accidental DROP:
  pg_flashback doctor
  pg_flashback config recommend
  pg_flashback protect public.orders
  # ... later, after DROP TABLE public.orders;
  pg_flashback --json recover public.orders
  # equivalent:
  pg_flashback recover public.orders --json

After install, verify the CLI on PATH matches the installed package:
  command -v pg_flashback
  pg_flashback version
EOF
}

die() { echo "pg_flashback: $*" >&2; exit 2; }
fail() { echo "pg_flashback: $*" >&2; exit 1; }

reject_controls() {
    local name=$1 value=$2
    if [[ "$value" == *[[:cntrl:]]* ]]; then
        die "refusing control characters in $name"
    fi
}

human_bytes() {
    local n=${1:-0}
    if (( n >= 1073741824 )); then
        awk -v n="$n" 'BEGIN { printf "%.1f GB", n/1073741824 }'
    elif (( n >= 1048576 )); then
        awk -v n="$n" 'BEGIN { printf "%.1f MB", n/1048576 }'
    elif (( n >= 1024 )); then
        awk -v n="$n" 'BEGIN { printf "%.1f KB", n/1024 }'
    else
        printf '%s B' "$n"
    fi
}

psql_stdin() {
    local timeout_sql="SET statement_timeout TO ${STATEMENT_TIMEOUT_MS};"
    {
        printf '%s\n' "$timeout_sql"
        cat
    } | "$PSQL_BIN" -X -v ON_ERROR_STOP=1 "$@"
}

psql_tuples() {
    psql_stdin -qAt "$@"
}

psql_tuples_db() {
    local db=$1
    shift
    PGDATABASE="$db" psql_tuples "$@"
}

emit_envelope() {
    local command=$1 status=$2 code=$3
    local data=${4:-null}
    local err=${5:-null}
    jq -n \
        --arg command "$command" \
        --arg status "$status" \
        --arg code "$code" \
        --argjson data "$data" \
        --argjson error "$err" \
        '{schema_version:1, command:$command, status:$status, code:$code, data:$data, error:$error}'
}

list_target_databases() {
    # Enumerate configured flashback target databases from GUCs — not every
    # connectable pg_database. postgres is included only when configured.
    psql_tuples <<'SQL'
WITH raw AS (
    SELECT COALESCE(
        NULLIF(current_setting('pg_flashback.target_databases', true), ''),
        NULLIF(current_setting('pg_flashback.target_database', true), ''),
        current_database()
    ) AS csv
),
names AS (
    SELECT DISTINCT trim(both FROM x) AS datname
    FROM raw, unnest(string_to_array(raw.csv, ',')) AS x
    WHERE trim(both FROM x) <> ''
)
SELECT n.datname
FROM names n
JOIN pg_database d ON d.datname = n.datname
WHERE d.datallowconn AND NOT d.datistemplate
ORDER BY 1;
SQL
}

for_each_database() {
    local fn=$1
    local db any_fail=0
    while IFS= read -r db; do
        [[ -n "$db" ]] || continue
        if ! "$fn" "$db"; then
            any_fail=1
            echo "pg_flashback: database $db failed" >&2
        fi
    done < <(list_target_databases)
    return "$any_fail"
}

canonical_table_name() {
    local table=$1
    psql_tuples -v "table=$table" <<'SQL'
SELECT flashback_resolve_lifecycle_name(:'table');
SQL
}

wait_health() {
    local table=$1 timeout_s=$2 label=$3
    local deadline health
    deadline=$(( $(date +%s) + timeout_s ))
    while (( $(date +%s) <= deadline )); do
        health=$(psql_tuples -v "table=$table" <<'SQL'
SELECT flashback_lifecycle_health(:'table');
SQL
)
        if [[ "$health" == "healthy" ]]; then
            printf '%s\n' "$health"
            return 0
        fi
        sleep 0.1
    done
    fail "$label timed out waiting for healthy coverage (last=$health)"
}

confirm_yes() {
    local prompt=$1
    local answer
    if [[ "$YES" == 1 ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        die "non-interactive recover requires --yes (and usually --latest-drop)"
    fi
    printf '%s ' "$prompt" >/dev/tty
    IFS= read -r answer </dev/tty || answer=""
    [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

doctor_action_for_humans() {
    local check=$1 status=$2 action=$3
    case "$status" in
        ok) printf 'OK' ;;
        warning)
            if [[ "$action" == "none" || -z "$action" ]]; then
                printf 'Warning — review configuration'
            else
                printf 'Warning — %s' "$action"
            fi
            ;;
        error)
            if [[ "$action" == "none" || -z "$action" ]]; then
                printf 'Action required'
            else
                printf 'Action: %s' "$action"
            fi
            ;;
        *) printf '%s' "${action:-see details}" ;;
    esac
}

doctor_one_db() {
    local db=${1:-}
    local errors n installed
    local psql_cmd=(psql_tuples)
    if [[ -n "$db" ]]; then
        psql_cmd=(psql_tuples_db "$db")
    fi

    installed=$("${psql_cmd[@]}" <<'SQL'
SELECT EXISTS(SELECT 1 FROM pg_extension WHERE extname='pg_flashback');
SQL
) || installed="f"
    if [[ "$installed" != "t" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            if [[ -n "$db" ]]; then
                jq -n --arg db "$db" \
                    '{database:$db, checks:null, error:{code:"extension_missing", message:"pg_flashback extension is not installed in this database"}}'
            else
                emit_envelope doctor error extension_missing \
                    '{"checks":null}' \
                    '{"code":"extension_missing","message":"pg_flashback extension is not installed"}'
            fi
        else
            echo "pg_flashback doctor${db:+ ($db)}: extension_missing"
        fi
        return 1
    fi

    if [[ "${DOCTOR_RECONCILE:-0}" == 1 ]]; then
        n=$("${psql_cmd[@]}" <<'SQL'
SELECT flashback_finalize_recover_operations()
     + flashback_finalize_unprotect_operations()
     + flashback_reconcile_recover_operations(interval '5 minutes');
SQL
)
        if [[ -n "$db" ]]; then
            echo "Reconciled($db): finalized=$n" >&2
        else
            echo "Reconciled recover/unprotect operations: finalized=$n" >&2
        fi
    fi
    if [[ "$JSON_OUT" == 1 ]]; then
        local checks
        checks=$("${psql_cmd[@]}" <<'SQL'
SELECT COALESCE(json_agg(row_to_json(d) ORDER BY d.check_name), '[]'::json)
FROM flashback_doctor() d;
SQL
)
        if [[ -n "$db" ]]; then
            jq -n --arg db "$db" --argjson checks "$checks" \
                '{database:$db, checks:$checks, error:null}'
        else
            emit_envelope doctor ok ok "$checks" null
        fi
    else
        echo "pg_flashback doctor${db:+ ($db)}"
        echo "==================="
        while IFS=$'\t' read -r scope check status observed expected action; do
            human="$(doctor_action_for_humans "$check" "$status" "$action")"
            printf '\n[%s] %s\n' "$status" "$check"
            echo "  Scope: ${scope:-database}"
            if [[ "$VERBOSE" == 1 ]]; then
                echo "  Observed: $observed"
                echo "  Expected: $expected"
            fi
            echo "  $human"
        done < <("${psql_cmd[@]}" <<'SQL'
SELECT scope, check_name, status, observed, expected, action
FROM flashback_doctor()
ORDER BY CASE status WHEN 'error' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END,
         check_name;
SQL
)
        echo
    fi
    errors=$("${psql_cmd[@]}" <<'SQL'
SELECT count(*) FROM flashback_doctor() WHERE status='error';
SQL
)
    [[ "$errors" == "0" ]]
}

cmd_config() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        recommend) cmd_config_recommend "$@" ;;
        ""|-h|--help) die "config requires a subcommand (recommend)" ;;
        *) die "unknown config subcommand: $sub" ;;
    esac
}

cmd_config_recommend() {
    local table=${1:-} payload
    if [[ -n "$table" ]]; then
        reject_controls table "$table"
        payload="$(psql_tuples -v "table=$table" <<'SQL'
SELECT flashback_config_recommend(:'table'::regclass, NULL);
SQL
)" || fail "flashback_config_recommend failed"
    else
        payload="$(psql_tuples <<'SQL'
SELECT flashback_config_recommend(NULL::regclass, NULL);
SQL
)" || fail "flashback_config_recommend failed"
    fi
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope config_recommend ok ok "$payload" null
        return 0
    fi
    echo "pg_flashback config recommend (local_delta)"
    echo "=========================================="
    echo "Read-only advice. pg_flashback does not edit postgresql.conf."
    echo
    echo "Copy these lines into postgresql.conf (restart required):"
    printf '%s' "$payload" | jq -r '.recommended_postgresql_conf_lines[]?'
    echo
    echo "Operator role (after CREATE EXTENSION):"
    printf '%s' "$payload" | jq -r '.operator_role_sql // empty'
    if [[ "$(printf '%s' "$payload" | jq -r '.missing_capacity_gucs | length')" != "0" ]]; then
        echo
        echo "Missing capacity GUCs (protect fails closed until set):"
        printf '%s' "$payload" | jq -r '.missing_capacity_gucs[]?'
    fi
    notes="$(printf '%s' "$payload" | jq -r '.notes[]?' 2>/dev/null || true)"
    if [[ -n "$notes" ]]; then
        echo
        echo "Notes:"
        printf '%s\n' "$notes" | sed 's/^/  - /'
    fi
}

default_recover_lookback() {
    local table=$1
    local horizon
    horizon="$(psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(
    (
        SELECT GREATEST(rs.retention_interval, interval '1 hour')::text
        FROM flashback_retention_status() rs
        WHERE rs.table_name = :'table'
           OR rs.table_name = format('%I.%I',
                split_part(:'table', '.', 1),
                split_part(:'table', '.', 2))
        ORDER BY 1
        LIMIT 1
    ),
    '7 days'
);
SQL
)" || horizon="7 days"
    printf '%s' "${horizon:-7 days}"
}

cmd_doctor() {
    if [[ "$ALL_DATABASES" == 1 ]]; then
        local db payloads=() fail=0 chunk
        while IFS= read -r db; do
            [[ -n "$db" ]] || continue
            if chunk=$(doctor_one_db "$db"); then
                payloads+=("$chunk")
            else
                fail=1
                payloads+=("$chunk")
                echo "pg_flashback: doctor failed for database $db" >&2
            fi
        done < <(list_target_databases)
        if [[ "$JSON_OUT" == 1 ]]; then
            local arr
            arr=$(printf '%s\n' "${payloads[@]+"${payloads[@]}"}" | jq -s '.')
            if [[ "$fail" == 0 ]]; then
                emit_envelope doctor ok ok "$arr" null
            else
                emit_envelope doctor error partial_failure "$arr" \
                    '{"message":"one or more databases failed doctor"}'
                return 1
            fi
        fi
        return "$fail"
    fi
    doctor_one_db || exit 1
}

cmd_version() {
    local ext
    ext=$(psql_tuples <<'SQL'
SELECT COALESCE(
    (SELECT extversion FROM pg_extension WHERE extname = 'pg_flashback'),
    'not_installed'
);
SQL
) || ext="unreachable"
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope version ok ok \
            "$(jq -n --arg cli "$CLI_VERSION" --arg ext "$ext" \
                '{cli_version:$cli, extension_version:$ext}')" null
    else
        echo "pg_flashback cli=$CLI_VERSION extension=$ext"
    fi
}

require_version_match() {
    local ext
    ext=$(psql_tuples <<'SQL'
SELECT COALESCE(
    (SELECT extversion FROM pg_extension WHERE extname = 'pg_flashback'),
    'missing'
);
SQL
) || ext=missing
    if [[ "$ext" != "$CLI_VERSION" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            emit_envelope version_guard error version_mismatch \
                "$(jq -n --arg cli "$CLI_VERSION" --arg ext "$ext" '{cli_version:$cli,extension_version:$ext}')" \
                "$(jq -n --arg cli "$CLI_VERSION" --arg ext "$ext" '{message:"CLI/extension version mismatch",action:"install matching package binaries",cli:$cli,extension:$ext}')"
        else
            echo "Problem: CLI version $CLI_VERSION does not match extension $ext"
            echo "Impact: refusing mutating command"
            echo "Action: install matching pg_flashback package (CLI + .so + SQL)"
        fi
        exit 1
    fi
}

cmd_list() {
    local payload
    payload=$(psql_tuples <<'SQL'
SELECT flashback_list_lifecycles();
SQL
)
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope list ok ok "$payload" null
    else
        echo "Protected lifecycles (local_delta)"
        printf '%s\n' "$payload" | jq -r '.[] | "  \(.table_name) tracking_id=\(.tracking_id) active=\(.is_active) state=\(.protection_state)"'
    fi
}

cmd_history() {
    local table=${1:-}
    local payload
    if [[ -n "$table" ]]; then
        reject_controls table "$table"
        payload=$(psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(jsonb_agg(to_jsonb(h) ORDER BY h.created_at DESC), '[]'::jsonb)
FROM flashback_operation_history(NULLIF(:'table',''), interval '7 days') h;
SQL
)
    else
        payload=$(psql_tuples <<'SQL'
SELECT COALESCE(jsonb_agg(to_jsonb(h) ORDER BY h.created_at DESC), '[]'::jsonb)
FROM flashback_operation_history(NULL, interval '7 days') h;
SQL
)
    fi
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope history ok ok "$payload" null
    else
        echo "Operation history"
        printf '%s\n' "$payload" | jq -r '.[] | "  #\(.operation_id) \(.command) \(.table_name // "-") state=\(.state) at=\(.created_at)"'
    fi
}

cmd_changes() {
    local table=${1:-}
    [[ -n "$table" ]] || die "changes requires TABLE"
    reject_controls table "$table"
    local payload
    payload=$(psql_tuples -v "table=$table" <<'SQL'
SELECT COALESCE(jsonb_agg(to_jsonb(x) ORDER BY x.event_time DESC), '[]'::jsonb)
FROM (
    SELECT event_time, event_type, row_identity
    FROM flashback_history(:'table', interval '1 hour')
    LIMIT 100
) x;
SQL
) || fail "changes failed (row history may be restricted by RBAC)"
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope changes ok ok "$payload" null
    else
        echo "Recent row-change metadata for $table (payloads omitted in CLI summary)"
        printf '%s\n' "$payload" | jq -r '.[] | "  \(.event_time) \(.event_type)"'
    fi
}

cmd_protect() {
    local table=$1
    local canon already health rec advise_json
    require_version_match
    reject_controls table "$table"
    canon="$(canonical_table_name "$table")"

    already=$(psql_tuples -v "table=$table" <<'SQL'
SELECT CASE WHEN flashback_is_actively_protected(:'table') THEN 'yes' ELSE 'no' END;
SQL
)

    if [[ "$already" == "yes" ]]; then
        health="$(wait_health "$table" "$PROTECT_HEALTH_TIMEOUT_S" "protect")"
        if [[ "$JSON_OUT" == 1 ]]; then
            jq -n --arg table "$canon" --arg health "$health" \
                '{command:"protect", table:$table, result:"already_protected", health:$health}'
        else
            echo "Already protected: $canon"
            echo "Coverage is healthy. No second protection lifecycle was started."
        fi
        return 0
    fi

    advise_json=$(psql_tuples -v "table=$table" <<'SQL'
SELECT row_to_json(a)
FROM flashback_advise((:'table')::regclass) a;
SQL
)
    rec=$(printf '%s' "$advise_json" | jq -r '.recommendation // empty')
    [[ -n "$rec" ]] || die "protect preflight failed for $table"

    if [[ "$JSON_OUT" != 1 ]]; then
        echo "Protect preflight for $canon"
        echo "  Estimated protected copy size: $(human_bytes "$(printf '%s' "$advise_json" | jq -r '.projected_base_snapshot_bytes // 0')")"
        echo "  Estimated restore peak: $(human_bytes "$(printf '%s' "$advise_json" | jq -r '.projected_restore_peak_bytes // 0')")"
        echo "  Free disk now: $(human_bytes "$(printf '%s' "$advise_json" | jq -r '.filesystem_available_bytes // 0')")"
        echo "  Recommendation: $rec"
    fi

    if [[ "$rec" == reject* || "$rec" == *"configure local"* ]]; then
        fail "cannot protect $canon yet — $rec"
    fi

    psql_tuples -v "table=$table" <<'SQL' >/dev/null
SELECT flashback_track(:'table');
SQL
    health="$(wait_health "$table" "$PROTECT_HEALTH_TIMEOUT_S" "protect")"

    if [[ "$JSON_OUT" == 1 ]]; then
        jq -n --arg table "$canon" --arg health "$health" --argjson advise "$advise_json" \
            '{command:"protect", table:$table, result:"protected", health:$health, advise:$advise}'
    else
        echo "Protected: $canon"
        echo "Coverage is healthy. Accidental DROP can now be recovered with:"
        echo "  pg_flashback recover $canon"
        if [[ "$VERBOSE" == 1 ]]; then
            echo "Technical: health=$health"
        fi
    fi
}

cmd_status() {
    local table=${1:-}
    local payload
    if [[ -n "$table" ]]; then
        reject_controls table "$table"
    fi

    payload=$(psql_tuples -v "table=${table:-}" <<'SQL'
SELECT flashback_status_snapshot(NULLIF(:'table', ''));
SQL
)

    if [[ "$JSON_OUT" == 1 ]]; then
        # Single-DB --json returns the status payload object. --all-databases wraps
        # each database payload and emits the outer envelope in cmd_status_dispatch.
        printf '%s\n' "$payload"
        return 0
    fi

    local capture_running maint_running admission slot_status lag_bytes disk_bytes
    local dr_used dr_budget dr_reclaimable dr_retention dr_oldest
    capture_running=$(printf '%s' "$payload" | jq -r '.workers.capture_running')
    maint_running=$(printf '%s' "$payload" | jq -r '.workers.maintenance_running')
    admission=$(printf '%s' "$payload" | jq -r '.workers.admission_state')
    slot_status=$(printf '%s' "$payload" | jq -r '.slot.wal_status // "none"')
    lag_bytes=$(printf '%s' "$payload" | jq -r '.slot.retained_bytes // 0')
    disk_bytes=$(printf '%s' "$payload" | jq -r '.flashback_disk_bytes // 0')
    dr_used=$(printf '%s' "$payload" | jq -r '.disk_retention.used_bytes // empty')
    dr_budget=$(printf '%s' "$payload" | jq -r '.disk_retention.configured_snapshot_budget // "unknown"')
    dr_reclaimable=$(printf '%s' "$payload" | jq -r '.disk_retention.reclaimable_bytes // 0')
    dr_retention=$(printf '%s' "$payload" | jq -r '.disk_retention.configured_retention // "unknown"')
    dr_oldest=$(printf '%s' "$payload" | jq -r '.disk_retention.oldest_recoverable_point // "unknown"')

    echo "pg_flashback status"
    echo "==================="
    echo "Workers: capture=$([[ "$capture_running" == "true" ]] && echo running || echo not-running), maintenance=$([[ "$maint_running" == "true" ]] && echo running || echo not-running) ($admission)"
    if [[ "$slot_status" == "none" ]]; then
        echo "WAL capture slot: none yet (appears after the first protected table)"
    else
        echo "WAL capture slot: $slot_status; retained history ≈ $(human_bytes "$lag_bytes")"
        if [[ "$slot_status" == "lost" || "$slot_status" == "unreserved" ]]; then
            echo "  Risk: WAL progress may be lost — recover may be unavailable until re-protect/re-anchor."
        elif (( lag_bytes > 268435456 )); then
            echo "  Risk: retained WAL history is growing; check disk and retention."
        fi
    fi
    echo "Approx. flashback disk use: $(human_bytes "$disk_bytes")"
    echo "Disk retention: used=$([[ -n "$dr_used" ]] && human_bytes "$dr_used" || echo unknown), reclaimable=$(human_bytes "$dr_reclaimable"), snapshot_budget=$dr_budget, retention=$dr_retention, oldest_recoverable=$dr_oldest"
    echo

    local count
    count=$(printf '%s' "$payload" | jq '.tables | length')
    if [[ "$count" == "0" ]]; then
        if [[ -n "$table" ]]; then
            echo "Table $table is not protected."
            echo "Action: pg_flashback protect $table"
        else
            echo "No protected tables."
            echo "Action: pg_flashback protect public.your_table"
        fi
        return 0
    fi

    printf '%s' "$payload" | jq -r --arg verbose "$VERBOSE" \
      '.tables[] as $t
      | (($t.health == "healthy") and (($t.open_gap_count // 0) == 0)) as $healthy
      | ((.latest_drop_recoverability // []) | map(select(.table_name == $t.table_name)) | .[0]) as $drop
      | [
          "Table: \($t.table_name)",
          "  Protected: yes",
          "  Coverage health: \(if $healthy then "healthy" else ($t.health // "degraded") end)",
          "  Latest DROP restorable: \(
              if $drop == null then "no DROP in lookback"
              elif ($drop.restorable == true) then "yes"
              else "no (\($drop.status // "non_restorable"))" end)",
          "  Gap: \(if (($t.open_gap_count // 0) == 0) then "none" else "yes (\($t.open_gap_count) open)" end)",
          (if (($t.recommended_action // "none") != "none" and ($t.recommended_action // "none") != "null")
            then "  Action needed: \($t.recommended_action)"
            else "  Action needed: none" end),
          (if $verbose == "1" then
            "  Technical health: \($t.health)\n  Technical valid_through_lsn: \($t.valid_through_lsn // "")\n  Technical profile: \($t.recovery_profile // "")\n  Latest DROP reason: \($drop.reason // "")"
           else empty end)
        ] | join("\n")'
}



pick_recover_target() {
    local table=$1
    local lookback=${2:-7 days}
    reject_controls lookback "$lookback"

    if [[ -n "$AT_LSN" ]]; then
        reject_controls lsn "$AT_LSN"
        psql_tuples -v "table=$table" -v "lsn=$AT_LSN" <<'SQL'
SELECT jsonb_build_object(
    'selection', 'explicit_lsn',
    'table_name', :'table',
    'safe_target_lsn', :'lsn'::pg_lsn,
    'disaster_time', null,
    'status', 'restorable',
    'reason', 'operator-supplied LSN',
    'candidates', 1
);
SQL
        return 0
    fi

    if [[ -n "$AT_TIMESTAMP" ]]; then
        reject_controls timestamp "$AT_TIMESTAMP"
        psql_tuples -v "table=$table" -v "ts=$AT_TIMESTAMP" <<'SQL'
WITH r AS (
    SELECT * FROM flashback_resolve_target(:'table', :'ts'::timestamptz)
)
SELECT jsonb_build_object(
    'selection', 'timestamp',
    'table_name', :'table',
    'safe_target_lsn', (SELECT target_lsn FROM r LIMIT 1),
    'disaster_time', :'ts'::timestamptz,
    'status', CASE WHEN EXISTS(SELECT 1 FROM r) THEN 'restorable' ELSE 'non_restorable' END,
    'reason', COALESCE((SELECT reason FROM r LIMIT 1), 'no resolvable target'),
    'candidates', (SELECT count(*) FROM r)
)
FROM (SELECT 1) _;
SQL
        return 0
    fi

    # Default / --latest-drop: chronologically latest DROP by COMMIT LSN only.
    # Evaluate that single event. Never fall back to an older restorable DROP.
    psql_tuples -v "table=$table" -v "lookback=$lookback" <<'SQL'
WITH d AS (
    SELECT *
    FROM flashback_disaster_points(:'table', :'lookback'::interval)
    WHERE event_type = 'DROP'
),
latest AS (
    SELECT *
    FROM d
    ORDER BY disaster_commit_lsn DESC NULLS LAST, disaster_time DESC NULLS LAST
    LIMIT 1
)
SELECT jsonb_build_object(
    'selection', 'latest_drop',
    'table_name', COALESCE((SELECT table_name FROM latest), :'table'),
    'safe_target_lsn', (SELECT safe_target_lsn FROM latest
                        WHERE status = 'restorable' AND safe_target_lsn IS NOT NULL),
    'disaster_time', (SELECT disaster_time FROM latest),
    'disaster_commit_lsn', (SELECT disaster_commit_lsn FROM latest),
    'generation_id', (SELECT generation_id FROM latest),
    'status', COALESCE((SELECT status FROM latest), 'missing'),
    'reason', COALESCE(
        (SELECT reason FROM latest),
        'no DROP events found in lookback window'
    ),
    'candidates', (SELECT count(*) FROM d),
    'restorable_candidates', (
        SELECT count(*) FROM d
        WHERE status = 'restorable' AND safe_target_lsn IS NOT NULL
    ),
    'silent_fallback_forbidden', true
);
SQL
}

cmd_recover() {
    local table=$1
    local canon plan status reason lsn disaster_time selection token op_id health code
    local begin_json exec_json deadline now lookback
    require_version_match
    reject_controls table "$table"
    canon="$(canonical_table_name "$table")"

    if [[ -z "$AT_LSN" && -z "$AT_TIMESTAMP" && -z "$DISASTER_EVENT_ID" ]]; then
        LATEST_DROP=1
    fi
    : "${LATEST_DROP:=1}"

    if [[ -z "$LOOKBACK" ]]; then
        LOOKBACK="$(default_recover_lookback "$table")"
    fi
    lookback="$LOOKBACK"
    reject_controls lookback "$lookback"

    # Bounded discovery: poll while capture frontier lags or exact manifest bind pending.
    deadline=$(( $(date +%s) + DISCOVERY_TIMEOUT_S ))
    while true; do
        plan="$(psql_tuples -v "table=$table" -v "lookback=$lookback" \
            -v "event_id=${DISASTER_EVENT_ID:-}" -v "ts=${AT_TIMESTAMP:-}" -v "lsn=${AT_LSN:-}" <<'SQL'
SELECT flashback_recover_plan(
    :'table',
    :'lookback'::interval,
    NULLIF(:'event_id', '')::bigint,
    NULLIF(:'ts', '')::timestamptz,
    NULLIF(:'lsn', '')::pg_lsn
);
SQL
)"
        status=$(printf '%s' "$plan" | jq -r '.status // empty')
        code=$(printf '%s' "$plan" | jq -r '.code // empty')
        if [[ "$code" != "capture_catchup_pending" && "$code" != "exact_manifest_pending" ]]; then
            break
        fi
        now=$(date +%s)
        if (( now >= deadline )); then
            if [[ "$code" == "exact_manifest_pending" ]]; then
                plan="$(printf '%s' "$plan" | jq '.code="exact_manifest_missing" | .status="error" | .reason=("exact pre-DROP dependency manifest was not bound within discovery timeout")')"
                code=exact_manifest_missing
            fi
            break
        fi
        sleep 0.5
    done

    reason=$(printf '%s' "$plan" | jq -r '.reason // .code // empty')
    lsn=$(printf '%s' "$plan" | jq -r '.target_lsn // empty')
    disaster_time=$(printf '%s' "$plan" | jq -r '.disaster_time // empty')
    selection=$(printf '%s' "$plan" | jq -r '.selection // empty')
    token=$(printf '%s' "$plan" | jq -r '.plan_token // empty')

    if [[ "$status" != "restorable" || -z "$lsn" || "$lsn" == "null" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            jq -n --argjson plan "$plan" \
                '{schema_version:1, command:"recover", status:"error",
                  code:($plan.code // "non_restorable"), data:{plan:$plan},
                  error:{message:($plan.reason // $plan.code // "not restorable"),
                         action:($plan.action // "run pg_flashback doctor and status")}}'
        else
            echo "Cannot recover $canon"
            echo "  Problem: ${reason:-no recoverable DROP found}"
            echo "  Impact: no mutation was performed"
            if [[ "$code" == "capture_catchup_pending" ]]; then
                echo "  Action: wait for worker catch-up, then retry; inspect: pg_flashback doctor / status $canon"
            elif [[ "$code" == "exact_manifest_pending" || "$code" == "exact_manifest_missing" ]]; then
                echo "  Action: wait for exact event-bound dependency manifest bind, then retry; refuse recovery without it"
            else
                echo "  Action: run pg_flashback doctor and pg_flashback status $canon"
            fi
        fi
        exit 1
    fi

    if [[ "$JSON_OUT" == 1 && "$DRY_RUN" == 1 ]]; then
        jq -n --argjson plan "$plan" \
            '{schema_version:1, command:"recover", status:"ok", code:"dry_run", data:{plan:$plan}, error:null}'
        return 0
    fi

    if [[ "$JSON_OUT" != 1 ]]; then
        echo "Recover plan for $canon"
        echo "  Found DROP time: ${disaster_time:-unknown}"
        echo "  Safe recovery point: just before that DROP"
        echo "  Coverage status: restorable"
        echo "  Operation: restore the table as it was immediately before the DROP"
        if [[ "$DRY_RUN" == 1 ]]; then
            echo "  Mode: dry-run (no mutation; plan_token is identity only)"
        fi
        if [[ "$VERBOSE" == 1 ]]; then
            echo "  Technical target LSN: $lsn"
            echo "  Selection mode: $selection"
            echo "  plan_token: $token"
        fi
    fi

    if [[ "$DRY_RUN" == 1 ]]; then
        echo "Dry-run complete; no restore executed."
        return 0
    fi

    if ! confirm_yes "$canon geri getirilsin mi? [y/N]"; then
        echo "Recover cancelled."
        exit 1
    fi

    # TX A: durable begin (autocommit). TX B: execute. TX C on failure: mark_failed.
    begin_json="$(psql_tuples -v "table=$table" -v "token=$token" \
        -v "lookback=${LOOKBACK:-24 hours}" \
        -v "event_id=${DISASTER_EVENT_ID:-}" -v "ts=${AT_TIMESTAMP:-}" -v "lsn=${AT_LSN:-}" <<'SQL'
SELECT flashback_recover_begin(
    :'table',
    :'token',
    :'lookback'::interval,
    NULLIF(:'event_id', '')::bigint,
    NULLIF(:'ts', '')::timestamptz,
    NULLIF(:'lsn', '')::pg_lsn
);
SQL
)"
    op_id=$(printf '%s' "$begin_json" | jq -r '.operation_id // empty')
    [[ -n "$op_id" && "$op_id" != "null" ]] || fail "recover begin did not return operation_id"

    set +e
    exec_json="$(psql_tuples -v "table=$table" -v "token=$token" -v "opid=$op_id" \
        -v "lookback=${LOOKBACK:-24 hours}" \
        -v "event_id=${DISASTER_EVENT_ID:-}" -v "ts=${AT_TIMESTAMP:-}" -v "lsn=${AT_LSN:-}" <<'SQL'
SELECT flashback_recover_execute(
    :'table',
    :'token',
    :'lookback'::interval,
    NULLIF(:'event_id', '')::bigint,
    NULLIF(:'ts', '')::timestamptz,
    NULLIF(:'lsn', '')::pg_lsn,
    :'opid'::bigint
);
SQL
)"
    local exec_rc=$?
    set -e
    if [[ "$exec_rc" -ne 0 ]]; then
        psql_tuples -v "opid=$op_id" -v "msg=${exec_json:-execute failed}" <<'SQL' >/dev/null || true
SELECT flashback_recover_mark_failed(
    :'opid'::bigint,
    NULL,
    'restore_failed',
    left(:'msg', 500),
    jsonb_build_object('cli', 'pg_flashback')
);
SQL
        fail "recover execute failed for operation_id=$op_id (durable failed event recorded)"
    fi

    health="$(wait_health "$table" "$RECOVER_HEALTH_TIMEOUT_S" "recover")"
    # Worker/finalizer owns verified; CLI only observes the projection.
    local state=""
    for _ in $(seq 1 "$RECOVER_HEALTH_TIMEOUT_S"); do
        state=$(psql_tuples -v "opid=$op_id" <<'SQL'
SELECT COALESCE(flashback_operation_state(:'opid'::bigint), 'missing');
SQL
)
        [[ "$state" == "verified" || "$state" == "failed" ]] && break
        sleep 1
    done
    [[ "$state" == "verified" ]] || fail "recover applied but not verified (state=${state:-missing}); run: pg_flashback doctor --reconcile"

    if [[ "$JSON_OUT" == 1 ]]; then
        jq -n --arg table "$canon" --arg health "$health" --arg state "$state" \
            --argjson plan "$plan" --argjson begin "$begin_json" --argjson exec "$exec_json" \
            '{schema_version:1, command:"recover", status:"ok", code:"verified",
              data:{table:$table, health:$health, state:$state, plan:$plan, begin:$begin, execute:$exec}, error:null}'
    else
        echo "Recovered: $canon"
        echo "Coverage is healthy again (operation verified)."
        if [[ "$VERBOSE" == 1 ]]; then
            echo "Technical: health=$health state=$state operation_id=$op_id"
        fi
    fi
}

# Compatibility aliases kept for existing automation; not shown as primary help.
cmd_status_dispatch() {
    local table=${1:-}
    if [[ "$ALL_DATABASES" != 1 ]]; then
        cmd_status "$table"
        return
    fi
    local db fail=0 chunk arr installed
    local -a payloads=()
    while IFS= read -r db; do
        [[ -n "$db" ]] || continue
        installed=$(PGDATABASE="$db" psql_tuples <<'SQL'
SELECT EXISTS(SELECT 1 FROM pg_extension WHERE extname='pg_flashback');
SQL
) || installed="f"
        if [[ "$installed" != "t" ]]; then
            fail=1
            payloads+=("$(jq -n --arg db "$db" \
                '{database:$db, status:null, error:{code:"extension_missing", message:"pg_flashback extension is not installed in this database"}}')")
            continue
        fi
        if chunk=$(
            JSON_OUT=1
            PGDATABASE="$db" cmd_status "$table"
        ); then
            payloads+=("$(jq -n --arg db "$db" --argjson data "$chunk" '{database:$db, status:$data, error:null}')")
        else
            fail=1
            # Keep aggregate JSON valid even when a single DB fails.
            payloads+=("$(jq -n --arg db "$db" --arg raw "${chunk:-}" \
                '{database:$db, status:null, error:{code:"status_failed", message:($raw | if . == "" then "status failed" else . end)}}')")
        fi
    done < <(list_target_databases)
    arr=$(printf '%s\n' "${payloads[@]+"${payloads[@]}"}" | jq -s '.')
    if [[ "$JSON_OUT" == 1 ]]; then
        if [[ "$fail" == 0 ]]; then
            emit_envelope status ok ok "$arr" null
        else
            emit_envelope status error partial_failure "$arr" \
                '{"message":"one or more databases failed status"}'
        fi
    else
        printf '%s\n' "$arr" | jq -r '.[] | "database=\(.database) ok=\(.error == null)"'
    fi
    return "$fail"
}

cmd_unprotect() {
    require_version_match
    local table=$1
    local canon out status
    reject_controls table "$table"
    canon="$(canonical_table_name "$table")"
    if ! confirm_yes "$canon koruma dışı bırakılsın mı (unprotect)? [y/N]"; then
        echo "Unprotect cancelled."
        exit 1
    fi
    out="$(psql_tuples -v "table=$table" <<'SQL'
SELECT flashback_unprotect(:'table');
SQL
)"
    status=$(printf '%s' "$out" | jq -r '.status // empty')
    if [[ "$JSON_OUT" == 1 ]]; then
        jq -n --argjson data "$out" \
            '{schema_version:1, command:"unprotect", status:"ok", code:($data.code // "ok"), data:$data, error:null}'
    else
        echo "Unprotect started for $canon (status=$status)."
        echo "  Decoder filtering stays on until the stop marker COMMIT is consumed."
        echo "  Then run: pg_flashback cleanup --tracking-id $(printf '%s' "$out" | jq -r '.tracking_id')"
        if [[ "$VERBOSE" == 1 ]]; then
            echo "  Technical: $out"
        fi
    fi
}

cmd_cleanup() {
    local tid=$1
    local out status
    require_version_match
    reject_controls tracking_id "$tid"
    [[ "$tid" =~ ^[0-9]+$ ]] || die "cleanup --tracking-id requires a numeric id"
    if [[ "$DRY_RUN" != 1 ]]; then
        if ! confirm_yes "tracking_id=$tid payload cleanup? [y/N]"; then
            echo "Cleanup cancelled."
            exit 1
        fi
    fi
    out="$(psql_tuples -v "tid=$tid" -v "dry=${DRY_RUN:-0}" <<'SQL'
SELECT flashback_cleanup(:'tid'::bigint, (:'dry'::text IN ('1','true','t','yes')));
SQL
)"
    status=$(printf '%s' "$out" | jq -r '.status // empty')
    if [[ "$JSON_OUT" == 1 ]]; then
        jq -n --argjson data "$out" \
            '{schema_version:1, command:"cleanup", status:"ok", code:($data.code // "ok"), data:$data, error:null}'
    else
        echo "Cleanup $status for tracking_id=$tid"
        if [[ "$VERBOSE" == 1 || "$DRY_RUN" == 1 ]]; then
            echo "  Details: $out"
        fi
    fi
}

cmd_maintain() {
    local target=${1:-}
    local if_needed=0
    local plan out
    require_version_match
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --if-needed) if_needed=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            --yes) YES=1; shift ;;
            --json) JSON_OUT=1; shift ;;
            --verbose|-v) VERBOSE=1; shift ;;
            *) die "unknown maintain option: $1" ;;
        esac
    done
    [[ -n "$target" ]] || die "maintain requires TABLE or --all"
    if [[ "$target" == "--all" ]]; then
        local tables
        tables="$(psql_tuples <<'SQL'
SELECT COALESCE(jsonb_agg(x->>'table_name'), '[]'::jsonb)
FROM jsonb_array_elements(flashback_list_lifecycles()) x
WHERE (x->>'is_active')::boolean;
SQL
)"
        if [[ "$JSON_OUT" == 1 ]]; then
            local maintain_all_payload
            maintain_all_payload="$(jq -n --argjson tables "$tables" '{mode:"all",tables:$tables,note:"invoke per-table maintain"}')"
            emit_envelope maintain ok ok "$maintain_all_payload" null
            return 0
        fi
        printf '%s' "$tables" | jq -r '.[]' | while read -r t; do
            [[ -n "$t" ]] || continue
            if [[ "$if_needed" == 1 ]]; then
                plan="$(psql_tuples -v "table=$t" <<'SQL'
SELECT flashback_maintain_plan(:'table');
SQL
)"
                if [[ "$(printf '%s' "$plan" | jq -r '.recommended')" != "true" ]]; then
                    echo "maintain skip $t (not recommended)"
                    continue
                fi
            fi
            if [[ "$DRY_RUN" == 1 ]]; then
                cmd_maintain "$t" --dry-run
            else
                [[ "$YES" == 1 ]] || die "maintain --all requires --yes"
                cmd_maintain "$t" --yes
            fi
        done
        return 0
    fi

    reject_controls table "$target"
    plan="$(psql_tuples -v "table=$target" <<'SQL'
SELECT flashback_maintain_plan(:'table');
SQL
)" || fail "maintain plan failed"
    if [[ "$(printf '%s' "$plan" | jq -r '.status')" != "ok" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            emit_envelope maintain error "$(printf '%s' "$plan" | jq -r '.code')" "$plan" \
                "$(jq -n --argjson plan "$plan" '{message:($plan.code // "refused"), action:($plan.action // "")}')"
        else
            echo "Problem: maintain refused for $target ($(printf '%s' "$plan" | jq -r '.code'))"
            echo "Impact: no generation change"
            echo "Action: $(printf '%s' "$plan" | jq -r '.action // "resolve pending restore/building generation"')"
        fi
        exit 1
    fi
    if [[ "$if_needed" == 1 && "$(printf '%s' "$plan" | jq -r '.recommended')" != "true" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            emit_envelope maintain ok skipped "$plan" null
        else
            echo "maintain not needed for $target"
        fi
        return 0
    fi
    if [[ "$DRY_RUN" == 1 ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            emit_envelope maintain ok dry_run "$plan" null
        else
            echo "Maintain dry-run for $(printf '%s' "$plan" | jq -r '.table_name')"
            echo "  Would create a new WAL-aligned base/generation via reanchor"
            echo "  Peak disk estimate available in capacity projection when relation exists"
        fi
        return 0
    fi
    [[ "$YES" == 1 ]] || die "maintain requires --yes (or --dry-run)"
    # Fresh transaction: reanchor must be the first write. flashback_maintain_execute
    # is a thin flashback_maintain_begin() wrapper; it commits the reanchor and a
    # durable flashback.operations row (operation_id) in the same transaction.
    out="$(psql_tuples -v "table=$target" <<'SQL'
SELECT flashback_maintain_execute(:'table');
SQL
)" || fail "maintain execute failed"
    local op_id
    op_id=$(printf '%s' "$out" | jq -r '.operation_id // empty')

    # CLI polls flashback_maintain_finalize with separate psql invocations and a
    # bounded timeout; the server never sleeps on our behalf. Finalize seals the
    # predecessor generation (retained, not deleted) once the successor is healthy.
    local final_json="" fstate=""
    if [[ -n "$op_id" && "$op_id" != "null" ]]; then
        local deadline
        deadline=$(( $(date +%s) + MAINTAIN_FINALIZE_TIMEOUT_S ))
        while true; do
            final_json="$(psql_tuples -v "opid=$op_id" <<'SQL'
SELECT flashback_maintain_finalize(:'opid'::bigint);
SQL
)" || fail "maintain finalize failed for operation_id=$op_id"
            fstate=$(printf '%s' "$final_json" | jq -r '.status // empty')
            [[ "$fstate" == "sealed" ]] && break
            (( $(date +%s) >= deadline )) && break
            sleep 1
        done
    fi

    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope maintain ok ok "$(jq -n --argjson begin "$out" --argjson finalize "${final_json:-null}" \
            '{begin:$begin, finalize:$finalize}')" null
    else
        echo "Maintain started for $(printf '%s' "$out" | jq -r '.table_name') generation=$(printf '%s' "$out" | jq -r '.new_generation_id')"
        if [[ "$fstate" == "sealed" ]]; then
            echo "Predecessor generation sealed (retained until normal retention retires it)."
        else
            echo "Successor coverage not yet healthy after ${MAINTAIN_FINALIZE_TIMEOUT_S}s; predecessor stays active/retained."
            echo "Re-run 'pg_flashback status $target' or 'pg_flashback doctor' and retry maintain later — no data was lost."
        fi
    fi
}

cmd_prepare_uninstall() {
    local out execute=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes) YES=1; execute=true; shift ;;
            --json) JSON_OUT=1; shift ;;
            --verbose|-v) VERBOSE=1; shift ;;
            *) die "unknown prepare-uninstall option: $1" ;;
        esac
    done
    out="$(psql_tuples -v "exec=$execute" <<'SQL'
SELECT flashback_prepare_uninstall((:'exec'::text IN ('true','t','1','yes')));
SQL
)" || fail "prepare-uninstall failed"
    if [[ "$(printf '%s' "$out" | jq -r '.status')" != "ok" ]]; then
        if [[ "$JSON_OUT" == 1 ]]; then
            emit_envelope prepare_uninstall error "$(printf '%s' "$out" | jq -r '.code')" "$out" \
                "$(jq -n --argjson o "$out" '{message:($o.code // "refused"), action:($o.action // "")}')"
        else
            echo "Problem: uninstall not safe ($(printf '%s' "$out" | jq -r '.code'))"
            echo "Impact: extension/slots left unchanged"
            echo "Action: $(printf '%s' "$out" | jq -r '.action')"
        fi
        exit 1
    fi
    if [[ "$JSON_OUT" == 1 ]]; then
        emit_envelope prepare_uninstall ok "$(printf '%s' "$out" | jq -r '.code')" "$out" null
    else
        echo "prepare-uninstall: $(printf '%s' "$out" | jq -r '.code')"
        printf '%s\n' "$out" | jq -r '.next_steps[]?' | sed 's/^/  - /'
    fi
}

cmd_track() { cmd_protect "$1"; }
cmd_restore_compat() {
    # Advanced escape hatch: restore TABLE LSN --yes
    local table=$1 lsn=$2 confirm=${3:-}
    [[ "$confirm" == "--yes" ]] || die "legacy restore requires TABLE LSN --yes"
    AT_LSN="$lsn"
    YES=1
    cmd_recover "$table"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --json) JSON_OUT=1; shift ;;
        --verbose|-v) VERBOSE=1; shift ;;
        --yes) YES=1; shift ;;
        --latest-drop) LATEST_DROP=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --reconcile) DOCTOR_RECONCILE=1; shift ;;
        --all-databases) ALL_DATABASES=1; shift ;;
        --event-id)
            [[ $# -ge 2 ]] || die "--event-id requires ID"
            DISASTER_EVENT_ID=$2
            shift 2
            ;;
        --lookback)
            [[ $# -ge 2 ]] || die "--lookback requires INTERVAL"
            LOOKBACK=$2
            shift 2
            ;;
        --at)
            [[ $# -ge 2 ]] || die "--at requires TIMESTAMP"
            AT_TIMESTAMP=$2
            shift 2
            ;;
        --lsn)
            [[ $# -ge 2 ]] || die "--lsn requires LSN"
            AT_LSN=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
    esac
done

[[ $# -ge 1 ]] || { usage; exit 2; }
cmd=$1
shift

# Allow recover flags after the table as well.
case "$cmd" in
    recover|restore)
        args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                --yes) YES=1; shift ;;
                --latest-drop) LATEST_DROP=1; shift ;;
                --dry-run) DRY_RUN=1; shift ;;
                --event-id)
                    [[ $# -ge 2 ]] || die "--event-id requires ID"
                    DISASTER_EVENT_ID=$2
                    shift 2
                    ;;
                --lookback)
                    [[ $# -ge 2 ]] || die "--lookback requires INTERVAL"
                    LOOKBACK=$2
                    shift 2
                    ;;
                --at)
                    [[ $# -ge 2 ]] || die "--at requires TIMESTAMP"
                    AT_TIMESTAMP=$2
                    shift 2
                    ;;
                --lsn)
                    [[ $# -ge 2 ]] || die "--lsn requires LSN"
                    AT_LSN=$2
                    shift 2
                    ;;
                -*)
                    # legacy: recover TABLE LSN --yes  OR restore TABLE LSN --yes
                    if [[ "$cmd" == "restore" || ( $# -ge 2 && "$2" == "--yes" ) ]]; then
                        args+=("$1")
                        shift
                    else
                        die "unknown option: $1"
                    fi
                    ;;
                *) args+=("$1"); shift ;;
            esac
        done
        set -- "${args[@]+"${args[@]}"}"
        ;;
esac

case "$cmd" in
    doctor)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --reconcile) DOCTOR_RECONCILE=1; shift ;;
                --all-databases) ALL_DATABASES=1; shift ;;
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown doctor option: $1" ;;
                *) die "doctor takes no positional arguments" ;;
            esac
        done
        command -v jq >/dev/null || die "jq is required"
        cmd_doctor
        ;;
    config)
        carg=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown config option: $1" ;;
                *) carg+=("$1"); shift ;;
            esac
        done
        set -- "${carg[@]+"${carg[@]}"}"
        command -v jq >/dev/null || die "jq is required"
        cmd_config "$@"
        ;;
    version)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown version option: $1" ;;
                *) die "version takes no positional arguments" ;;
            esac
        done
        command -v jq >/dev/null || die "jq is required"
        cmd_version
        ;;
    list)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown list option: $1" ;;
                *) die "list takes no positional arguments" ;;
            esac
        done
        command -v jq >/dev/null || die "jq is required"
        cmd_list
        ;;
    history)
        hargs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown history option: $1" ;;
                *) hargs+=("$1"); shift ;;
            esac
        done
        set -- "${hargs[@]+"${hargs[@]}"}"
        [[ $# -le 1 ]] || die "history accepts optional TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_history "${1:-}"
        ;;
    changes)
        cargs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown changes option: $1" ;;
                *) cargs+=("$1"); shift ;;
            esac
        done
        set -- "${cargs[@]+"${cargs[@]}"}"
        [[ $# -eq 1 ]] || die "changes requires TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_changes "$1"
        ;;
    protect)
        pargs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown protect option: $1" ;;
                *) pargs+=("$1"); shift ;;
            esac
        done
        set -- "${pargs[@]+"${pargs[@]}"}"
        [[ $# -eq 1 ]] || die "protect requires TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_protect "$1"
        ;;
    track)
        targs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown track option: $1" ;;
                *) targs+=("$1"); shift ;;
            esac
        done
        set -- "${targs[@]+"${targs[@]}"}"
        [[ $# -eq 1 ]] || die "track requires TABLE"
        command -v jq >/dev/null || die "jq is required"
        echo "pg_flashback: 'track' is deprecated; use 'protect'" >&2
        cmd_track "$1"
        ;;
    status)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --all-databases) ALL_DATABASES=1; shift ;;
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                -*) die "unknown status option: $1" ;;
                *) break ;;
            esac
        done
        [[ $# -le 1 ]] || die "status accepts optional TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_status_dispatch "${1:-}"
        ;;
    recover)
        [[ $# -eq 1 ]] || die "recover requires TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_recover "$1"
        ;;
    unprotect)
        uargs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                --yes) YES=1; shift ;;
                -*) die "unknown unprotect option: $1" ;;
                *) uargs+=("$1"); shift ;;
            esac
        done
        set -- "${uargs[@]+"${uargs[@]}"}"
        [[ $# -eq 1 ]] || die "unprotect requires TABLE"
        command -v jq >/dev/null || die "jq is required"
        cmd_unprotect "$1"
        ;;
    cleanup)
        tid=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --tracking-id)
                    [[ $# -ge 2 ]] || die "--tracking-id requires ID"
                    tid=$2; shift 2 ;;
                --dry-run) DRY_RUN=1; shift ;;
                --yes) YES=1; shift ;;
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                *) die "unknown cleanup option: $1" ;;
            esac
        done
        [[ -n "$tid" ]] || die "cleanup requires --tracking-id ID"
        command -v jq >/dev/null || die "jq is required"
        cmd_cleanup "$tid"
        ;;
    untrack)
        die "untrack is deprecated; use: pg_flashback unprotect TABLE && pg_flashback cleanup --tracking-id ID"
        ;;
    restore)
        # Compatibility with the older restore TABLE LSN --yes command.
        [[ $# -eq 2 || $# -eq 3 ]] || die "legacy restore requires TABLE LSN --yes"
        command -v jq >/dev/null || die "jq is required"
        echo "pg_flashback: 'restore TABLE LSN' is deprecated; prefer 'recover TABLE --latest-drop --yes'" >&2
        if [[ $# -eq 2 ]]; then
            cmd_restore_compat "$1" "$2" "--yes"
        else
            cmd_restore_compat "$1" "$2" "$3"
        fi
        ;;
    maintain)
        margs=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) JSON_OUT=1; shift ;;
                --verbose|-v) VERBOSE=1; shift ;;
                --yes) YES=1; shift ;;
                --dry-run) DRY_RUN=1; shift ;;
                --if-needed|--all) margs+=("$1"); shift ;;
                -*) die "unknown maintain option: $1" ;;
                *) margs+=("$1"); shift ;;
            esac
        done
        set -- "${margs[@]+"${margs[@]}"}"
        [[ $# -ge 1 ]] || die "maintain requires TABLE or --all"
        command -v jq >/dev/null || die "jq is required"
        cmd_maintain "$@"
        ;;
    prepare-uninstall)
        command -v jq >/dev/null || die "jq is required"
        cmd_prepare_uninstall "$@"
        ;;
    advise|disasters|resolve)
        die "command '$cmd' moved out of the primary CLI; use SQL APIs or --verbose recover/protect flows"
        ;;
    *)
        die "unknown command: $cmd"
        ;;
esac
